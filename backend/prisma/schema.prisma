generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

//======================ENUMS==========================================

enum Role {
  VENDEDOR
  CAJERO
  ADMIN
  CLIENTE
}

enum ProductUnit {
  UNIDAD
  DECENA
  DOCENA
  CAJA
  BOLSA
  KG
  LITRO
  METRO
}

enum OrderStatus {
  PENDIENTE
  ENVIADA
  CANCELADA
}

enum InvoiceStatus {
  DRAFT
  PAGADO
  CANCELADO
  DEVOLUCION
}

enum PaymentMethod {
  EFECTIVO
  TARJETA_DEBITO
  TARJETA_CREDITO
  CHEQUE
  TRANSFERENCIA
  OTRO
}

enum UserStatus {
  ACTIVO
  INACTIVO
  SUSPENDIDO
}

enum CustomerType {
  PERSONA_FISICA
  PERSONA_JURIDICA
}

//====================MODELOS============================

model User {
  id_user       Int        @id @default(autoincrement())
  email         String     @unique
  name          String
  role          Role       @default(VENDEDOR)
  password_hash String     @db.VarChar(255)
  phone         String?    @db.VarChar(20)
  status        UserStatus @default(ACTIVO)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  invoices Invoice[]
  orders   Order[]
  customer Customer?
}

model Category {
  id_category   Int        @id @default(autoincrement())
  name          String     @unique
  description   String?
  id_parent     Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  parent        Category?  @relation("SubCategories", fields: [id_parent], references: [id_category], onDelete: Cascade)
  subcategories Category[] @relation("SubCategories")
  products      Product[]
}

model Product {
  id_product    Int         @id @default(autoincrement())
  code          String?     @unique
  name          String
  description   String?
  baseUnit      ProductUnit
  stock         Decimal     @default(0) @db.Decimal(12, 3)
  minStock      Decimal     @default(0) @db.Decimal(12, 3)
  id_category   Int
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  category      Category              @relation(fields: [id_category], references: [id_category])
  presentations ProductPresentation[]
}

model ProductPresentation {
  id_presentation Int         @id @default(autoincrement())
  id_product      Int
  unit            ProductUnit
  conversionRate  Decimal     @db.Decimal(12, 3)
  price           Decimal     @db.Decimal(12, 2)
  isDefault       Boolean     @default(false)
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  product      Product       @relation(fields: [id_product], references: [id_product], onDelete: Cascade)
  invoiceItems InvoiceItem[]
  orderItems   OrderItem[]

  @@unique([id_product, unit])
}

model Customer {
  id_customer    Int          @id @default(autoincrement())
  type           CustomerType @default(PERSONA_FISICA)
  name           String
  documentType   String?      @db.VarChar(10)
  documentNumber String?      @unique
  phone          String?      @db.VarChar(20)
  email          String?
  address        String?
  id_user        Int?         @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user     User?     @relation(fields: [id_user], references: [id_user])
  invoices Invoice[]
  orders   Order[]
}

// Modelo Order
model Order {
  id_order     Int         @id @default(autoincrement())
  id_customer  Int
  id_user      Int         // vendedor o cajero que creó la orden
  status       OrderStatus @default(PENDIENTE)
  observations String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  customer Customer    @relation(fields: [id_customer], references: [id_customer], onDelete: Cascade)
  user     User       @relation(fields: [id_user], references: [id_user])
  items    OrderItem[]
  invoice  Invoice?   // una orden puede tener 0 o 1 factura
}

// OrderItem
model OrderItem {
  id_orderitem    Int     @id @default(autoincrement())
  id_order        Int
  id_presentation Int
  quantity        Decimal @db.Decimal(12, 3)
  unitPrice       Decimal @db.Decimal(12, 2)
  subtotal        Decimal @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  order         Order                @relation(fields: [id_order], references: [id_order], onDelete: Cascade)
  presentation  ProductPresentation  @relation(fields: [id_presentation], references: [id_presentation])
}

// Actualizado: Invoice ahora referencia Order
model Invoice {
  id_invoice    Int           @id @default(autoincrement())
  invoiceNumber String        @unique
  id_order      Int?          // puede venir de una orden o ser directa
  status        InvoiceStatus @default(DRAFT)
  paymentMethod PaymentMethod
  subtotal      Decimal       @db.Decimal(12, 2)
  tax           Decimal       @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  id_user       Int           // cajero/admin que facturó
  id_customer   Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order    Order?         @relation(fields: [id_order], references: [id_order], onDelete: SetNull)
  user     User           @relation(fields: [id_user], references: [id_user])
  customer Customer       @relation(fields: [id_customer], references: [id_customer])
  items    InvoiceItem[]

  @@unique([id_order]) // cada orden → máximo 1 factura
}

model InvoiceItem {
  id_invoiceitem  Int      @id @default(autoincrement())
  id_invoice      Int
  id_presentation Int
  quantity        Decimal  @db.Decimal(12, 3)
  unitPrice       Decimal  @db.Decimal(12, 2)
  subtotal        Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  invoice      Invoice             @relation(fields: [id_invoice], references: [id_invoice], onDelete: Cascade)
  presentation ProductPresentation @relation(fields: [id_presentation], references: [id_presentation])
}