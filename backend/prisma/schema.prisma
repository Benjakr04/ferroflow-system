generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

//======================ENUMS==========================================

enum Role {
  VENDEDOR
  CAJERO
  ADMIN
  CLIENTE
}

enum ProductUnit {
  UNIDAD
  DECENA
  DOCENA
  CAJA
  BOLSA
  KG
  LITRO
  METRO
}

enum OrderStatus {
  PENDIENTE
  ENVIADA
  CANCELADA
}

enum InvoiceStatus {
  DRAFT
  PAGADO
  CANCELADO
  DEVOLUCION
}

enum PaymentMethod {
  EFECTIVO
  TARJETA_DEBITO
  TARJETA_CREDITO
  CHEQUE
  TRANSFERENCIA
  OTRO
}

enum UserStatus {
  ACTIVO
  INACTIVO
  SUSPENDIDO
}

enum CustomerType {
  PERSONA_FISICA
  PERSONA_JURIDICA
}

//====================MODELOS============================

model User {
  id_user       Int        @id @default(autoincrement())
  email         String     @unique
  name          String
  role          Role       @default(VENDEDOR)
  password_hash String     @db.VarChar(255)
  phone         String?    @db.VarChar(20)
  status        UserStatus @default(ACTIVO)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  invoices      Invoice[]      
  orders        Order[]
  customer      Customer?
}

model Category {
  id_category   Int        @id @default(autoincrement())
  name          String     @unique
  description   String?
  id_parent     Int?
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  parent        Category?  @relation("SubCategories", fields: [id_parent], references: [id_category], onDelete: Cascade)
  subcategories Category[] @relation("SubCategories")
  products      Product[]

  @@index([active])
}

model Product {
  id_product    Int         @id @default(autoincrement())
  code          String?     @unique
  name          String
  description   String?
  baseUnit      ProductUnit
  stock         Decimal     @default(0) @db.Decimal(12, 3)
  minStock      Decimal     @default(0) @db.Decimal(12, 3)
  id_category   Int
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  category      Category              @relation(fields: [id_category], references: [id_category])
  presentations ProductPresentation[]
}

model ProductPresentation {
  id_presentation Int         @id @default(autoincrement())
  id_product      Int
  unit            ProductUnit
  conversionRate  Decimal     @db.Decimal(12, 3)
  price           Decimal     @db.Decimal(12, 2)
  isDefault       Boolean     @default(false)
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  product      Product       @relation(fields: [id_product], references: [id_product], onDelete: Cascade)
  invoiceItems InvoiceItem[]
  orderItems   OrderItem[]

  @@unique([id_product, unit])
}

model Customer {
  id_customer    Int          @id @default(autoincrement())
  type           CustomerType @default(PERSONA_FISICA)
  name           String
  documentType   String?      @db.VarChar(10)      // CI, RUC, Pasaporte
  documentNumber String?      @unique
  phone          String?      @db.VarChar(20)
  email          String?
  address        String?
  id_user        Int?         @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User?        @relation(fields: [id_user], references: [id_user])
  invoices       Invoice[]   
  orders         Order[]
}

// Modelo Order
model Order {
  id_order     Int         @id @default(autoincrement())
  id_customer  Int
  id_user      Int         // vendedor o cajero que creó la orden
  status       OrderStatus @default(PENDIENTE)
  observations String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  customer Customer    @relation(fields: [id_customer], references: [id_customer], onDelete: Cascade)
  user     User       @relation(fields: [id_user], references: [id_user])
  items    OrderItem[]
  invoice  Invoice?   // una orden puede tener 0 o 1 factura
}

// OrderItem
model OrderItem {
  id_orderitem    Int     @id @default(autoincrement())
  id_order        Int
  id_presentation Int
  quantity        Decimal @db.Decimal(12, 3)
  unitPrice       Decimal @db.Decimal(12, 2)
  subtotal        Decimal @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  order         Order                @relation(fields: [id_order], references: [id_order], onDelete: Cascade)
  presentation  ProductPresentation  @relation(fields: [id_presentation], references: [id_presentation])
}

// Actualizado: Invoice ahora referencia Order
// Secuencia para numeracion atomica de facturas
/// Este comentario es para que Prisma no lo toque
/// CREATE SEQUENCE IF NOT EXISTS invoice_number_seq START 1;
model Invoice {
  id_invoice      Int           @id @default(autoincrement())
  
  // Identificación de la factura
  // Formato: 001-001-0000001 (establecimiento-punto_expedicion-secuencial)
  invoiceNumber   String        @unique
  
  // Estado de la factura: DRAFT (borrador), PAGADO, CANCELADO, DEVOLUCION
  status          InvoiceStatus @default(DRAFT)
  
  // Condición de venta: CONTADO o CREDITO
  saleCondition   String        // Obligatorio para SIFEN
  
  // Método de pago: EFECTIVO, TARJETA_DEBITO, TARJETA_CREDITO, CHEQUE, TRANSFERENCIA, OTRO
  paymentMethod   PaymentMethod
  
  // Fecha y hora de emisión de la factura
  emissionDate    DateTime      @default(now())
  
  // Desglose de montos (sin incluir IVA en subtotal)
  subtotal        Decimal       @db.Decimal(12, 2)  // Suma de todos los items sin IVA
  
  // Monto de IVA al 10% (tasa general para ferreterías)
  tax             Decimal       @db.Decimal(12, 2)  // IVA 10%
  
  // Total a pagar: subtotal + tax
  total           Decimal       @db.Decimal(12, 2)
  
  // Relación con la Orden que la generó
  // Una orden puede tener máximo una factura
  id_order        Int?          @unique
  
  // Usuario (CAJERO o ADMIN) que emitió la factura
  id_user         Int
  
  // Cliente que recibe la factura
  id_customer     Int
  
  // Datos del cliente copiados al momento de emitir (para auditoría)
  clientRUC       String?       @db.VarChar(15)
  clientType      String?       // PERSONA_FISICA o PERSONA_JURIDICA
  
  // Metadata
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  // Relaciones
  order           Order?        @relation(fields: [id_order], references: [id_order], onDelete: SetNull)
  user            User          @relation(fields: [id_user], references: [id_user])
  customer        Customer      @relation(fields: [id_customer], references: [id_customer])
  items           InvoiceItem[]
  
  @@index([status])
  @@index([id_customer])
  @@index([id_user])
  @@index([emissionDate])
}

model InvoiceItem {
  id_invoiceitem  Int      @id @default(autoincrement())
  
  // Relación con la factura
  id_invoice      Int
  
  // Referencia a la presentación del producto (para auditoría y traceabilidad)
  id_presentation Int
  
  // Cantidad vendida en esta línea
  quantity        Decimal  @db.Decimal(12, 3)
  
  // Precio unitario aplicado en la factura
  unitPrice       Decimal  @db.Decimal(12, 2)
  
  // Subtotal de la línea sin IVA: quantity * unitPrice
  subtotal        Decimal  @db.Decimal(12, 2)
  
  // Monto de IVA de esta línea al 10%: subtotal * 0.10
  ivaAmount       Decimal  @db.Decimal(12, 2)
  
  // Metadata
  createdAt       DateTime @default(now())
  
  // Relaciones
  invoice         Invoice             @relation(fields: [id_invoice], references: [id_invoice], onDelete: Cascade)
  presentation    ProductPresentation @relation(fields: [id_presentation], references: [id_presentation])
}